# ==============================================================================
# PaySync Backend - Variables de Entorno para Producción
# ==============================================================================

NODE_ENV=production

# Asignado automáticamente por la plataforma PaaS (Render, Railway, Fly.io, Heroku) o 3001
PORT=3001

# Ruta persistente de la base de datos SQLite (montada en disco persistente / volumen Docker)
DATABASE_PATH=/data/app_data.db

# Ruta persistente de almacenamiento de imágenes subidas
UPLOAD_DIR=/data/uploads

# Orígenes autorizados para CORS (reemplaza con la URL pública de tu Frontend)
# Ejemplo: https://paysync.vercel.app o https://tudominio.com
CORS_ORIGIN=https://tudominio.com

# Claves de API de Inteligencia Artificial (Configurar en el Dashboard del proveedor Cloud)
GEMINI_API_KEY=tu_clave_gemini_aqui
OPENAI_API_KEY=tu_clave_openai_aqui
