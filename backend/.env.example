# ==============================================================================
# PaySync Backend - Variables de Entorno (Desarrollo y Pruebas)
# ==============================================================================

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Puerto del servidor backend (por defecto: 3001)
PORT=3001

# Ruta del archivo SQLite (por defecto: ./app_data.db)
# En contenedores Docker con volúmenes persistentes: /data/app_data.db
DATABASE_PATH=./app_data.db

# Configuración de CORS
# En desarrollo: déjalo vacío o '*' para admitir cualquier origen
# En producción: URLs separadas por coma, ej: https://paysync.vercel.app,https://tudominio.com
CORS_ORIGIN=*

# ==============================================================================
# Proveedores de Inteligencia Artificial (Visión y OCR para Facturas)
# ==============================================================================

# Google Gemini Vision (Recomendado - Gratuito en AI Studio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI Vision (Opcional - Alternativa / Fallback GPT-4o-mini)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
