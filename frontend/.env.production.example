# ==============================================================================
# PaySync Frontend - Variables de Entorno para Producción (Vercel, Netlify, Cloud)
# ==============================================================================

# Si el Frontend se despliega por separado del Backend (ej. Vercel + Render):
# Configura aquí la URL pública de tu API Backend.
# Ejemplo: https://paysync-api.onrender.com o https://api.tudominio.com
VITE_API_URL=https://api.tudominio.com

# URL del servidor WebSocket (generalmente idéntica al origen del backend)
VITE_SOCKET_URL=https://api.tudominio.com

# NOTA: Si despliegas con Docker en modo Fullstack Unificado (donde Express sirve el frontend),
# NO necesitas definir estas variables; la app utilizará automáticamente las rutas relativas '/api' y '/'.
