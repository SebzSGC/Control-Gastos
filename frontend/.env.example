# ==============================================================================
# PaySync Frontend - Variables de Entorno (Desarrollo Local)
# ==============================================================================

# URL base del Backend en desarrollo (usado por el proxy local de Vite)
VITE_BACKEND_URL=http://localhost:3001

# Endpoint relativo consumido por el navegador (por defecto usa /api a través del proxy)
VITE_API_URL=/api

# Servidor WebSocket para tiempo real (por defecto '/' usa el mismo host/proxy)
VITE_SOCKET_URL=/
